{
  "name": "sellerledger/seller_ledger-woocommerce-plugin",
  "description": "Seller Ledger for WooCommerce",
  "homepage": "https://www.sellerledger.com/",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "composer/installers": "v2.0.0",
    "sellerledger/seller_ledger-php": "^1.3.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../seller_ledger-php*",
      "options": {
        "symlink": false,
        "versions": {
          "sellerledger/seller_ledger-php": "1.3.0"
        }
      }
    },
    {
      "type": "vcs",
      "url": "https://github.com/sellerledger/seller_ledger-php.git"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^9.3",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "woocommerce/woocommerce-sniffs": "^1.0"
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf"
  },
  "config": {
    "platform": {
      "php": "8.0.99"
    },
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
